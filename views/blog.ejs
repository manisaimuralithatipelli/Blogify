<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog</title>
</head>

<body>
    <%- include('./partials/nav') %>
        <div class="container mt-4">
            <h1>
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImageUrl %>" width="500px">
            <pre class="mt-3"><%= blog.content %></pre>
        </div>
        <div class="container mt-4">
            <% if (blog.createdBy) { %>
                <img src="<%= blog.createdBy.profileImageUrl %>" width="50px" class="rounded-circle">
                <span class="ml-2">
                    <%= blog.createdBy.fullName %>
                </span>
                <% } %>
        </div>
        <div class="container mt-3">
            <h1>Comments (<%= comments.length %>)</h1>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog.id %>" method="post">
                    <div class="mb-3">
                        <input type="text" class="form-control" name="content" placeholder="Enter your Comments">
                        <button class="btn btn-sm btn-primary" type="submit">Add</button>
                    </div>
                </form>
                <% } %>
                    <div class="mt-3">

                        <% comments.forEach(comment=> { %>

                            <div class="mb-3">

                                <img src="<%= comment.createdBy.profileImageUrl %>" width="50px" class="rounded-circle">

                                <span class="ml-2">
                                    <%= comment.createdBy.fullName %>
                                </span>

                                <pre><%= comment.content %></pre>

                            </div>

                            <% }) %>
                    </div>
        </div>
        <%- include('./partials/scripts') %>
</body>

</html>